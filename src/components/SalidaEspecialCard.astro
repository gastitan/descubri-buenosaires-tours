---
import type { CollectionEntry } from 'astro:content';
import ContentImage from './media/ContentImage.astro';
import { proximaFecha, formatearFecha } from '../lib/salidas';
import { ui, formatHora, formatDuracion, capitalizar } from '../i18n/es';

interface Props {
  salida: CollectionEntry<'salidasEspeciales'>;
}
const { salida } = Astro.props;
const { data } = salida;
const proxima = proximaFecha(data.fechas);
const fecha = proxima ? capitalizar(formatearFecha(proxima.inicio, { day: 'numeric', month: 'long' })) : null;
const hora = proxima ? formatHora(formatearFecha(proxima.inicio, { hour: '2-digit', minute: '2-digit' })) : null;
---

{
  proxima && (
    <a
      href={`/salidas/${salida.id}`}
      class="group flex flex-col overflow-hidden rounded-xl bg-azul-tinta text-blanco transition-transform hover:-translate-y-0.5 motion-reduce:transform-none"
    >
      <ContentImage
        src={data.imagen}
        carpeta="salidas"
        alt={data.imagenAlt}
        width={640}
        height={480}
        class="aspect-[4/3] w-full object-cover"
      />
      <div class="flex flex-1 flex-col gap-2 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-ocre">{ui.salidas.eyebrow}</p>
        <p class="font-display text-lg font-semibold">{data.nombre}</p>
        <p class="text-sm text-ocre">
          {fecha} · {hora}
        </p>
        <p class="text-sm text-arena/80">
          {formatDuracion(data.duracionMin, data.duracionMax)} · {data.barrios.join(', ')}
        </p>
        <span class="mt-auto pt-2 text-sm font-semibold text-ocre underline-offset-4 group-hover:underline">
          {ui.salidas.verDetalle}
        </span>
      </div>
    </a>
  )
}
