---
import { ui } from '../../i18n/es';

interface Props {
  alt: string;
  width: number;
  height: number;
  class?: string;
}
const { alt, width, height, class: className } = Astro.props;
---

<div
  class:list={['placeholder-img', className]}
  style={`aspect-ratio:${width}/${height}`}
  role="img"
  aria-label={alt}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="placeholder-img__icono">
    <path
      d="M4 5h16v14H4z M4 15l4-4 3 3 5-6 4 5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    />
  </svg>
  <div class="placeholder-img__texto">
    <span>{ui.media.fotoPendiente}</span>
    <span class="placeholder-img__alt">{alt}</span>
  </div>
</div>

<style>
  .placeholder-img {
    width: 100%;
    display: grid;
    place-items: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    background: repeating-linear-gradient(
      45deg,
      var(--color-arena) 0 10px,
      var(--color-blanco) 10px 20px
    );
    color: var(--color-azul-grafito);
    overflow: hidden;
    border-radius: inherit;
  }

  .placeholder-img__icono {
    width: 2rem;
    height: 2rem;
  }

  .placeholder-img__texto {
    display: flex;
    flex-direction: column;
    font-size: 0.875rem;
  }

  .placeholder-img__texto span:first-child {
    font-weight: 600;
  }

  .placeholder-img__alt {
    font-style: italic;
    opacity: 0.8;
  }
</style>
