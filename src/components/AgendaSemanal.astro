---
import type { CollectionEntry } from 'astro:content';
import FileteFlourish from './FileteFlourish.astro';
import { ui } from '../i18n/es';

interface Props {
  tours: CollectionEntry<'tours'>[];
}
const { tours } = Astro.props;

const DIAS = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'] as const;
const porDia = DIAS.map((dia) => ({
  dia,
  tours: tours.filter((t) => t.data.dia === dia).sort((a, b) => a.data.hora.localeCompare(b.data.hora)),
}));
const diasConTours = porDia.filter((d) => d.tours.length > 0);
---

<section id="agenda" aria-labelledby="agenda-titulo" class="mx-auto max-w-6xl px-4 py-12">
  <h2 id="agenda-titulo" class="font-display text-2xl font-semibold text-azul-tinta md:text-3xl">
    {ui.tours.agendaSemanal}
  </h2>
  <FileteFlourish class="mt-2 max-w-24" />

  <!-- Mobile: lista vertical, solo los días con recorridos -->
  <ul class="mt-6 flex flex-col gap-3 md:hidden">
    {
      diasConTours.map(({ dia, tours: toursDelDia }) => (
        <li class="rounded-lg border border-piedra/15 p-4">
          <p class="font-display capitalize text-azul-tinta">{dia}</p>
          <ul class="mt-2 flex flex-col gap-2">
            {toursDelDia.map((tour) => (
              <li>
                <a href={`/tours/${tour.id}`} class="flex items-baseline justify-between gap-3 text-sm">
                  <span class="font-semibold text-azul-grafito">{tour.data.hora} h</span>
                  <span class="text-azul-tinta underline-offset-4 hover:underline">{tour.data.nombre}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <!-- Desktop: grilla de 7 columnas tipo calendario -->
  <div class="mt-6 hidden grid-cols-7 gap-3 md:grid">
    {
      porDia.map(({ dia, tours: toursDelDia }) => (
        <div class="rounded-lg border border-piedra/15 p-3">
          <p class="font-display text-sm capitalize text-azul-tinta">{dia}</p>
          {toursDelDia.length > 0 ? (
            <ul class="mt-2 flex flex-col gap-2">
              {toursDelDia.map((tour) => (
                <li>
                  <a href={`/tours/${tour.id}`} class="block text-sm text-azul-grafito hover:text-azul-tinta">
                    <span class="block font-semibold">{tour.data.hora} h</span>
                    <span>{tour.data.nombre}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-piedra">—</p>
          )}
        </div>
      ))
    }
  </div>
</section>
