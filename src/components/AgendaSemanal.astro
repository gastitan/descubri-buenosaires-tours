---
import type { CollectionEntry } from 'astro:content';
import { getSiteData } from '../lib/content';
import { whatsappLink, mensajeTour, mensajeOtraFecha } from '../lib/whatsapp';
import { ui } from '../i18n/es';

interface Props {
  tours: CollectionEntry<'tours'>[];
}
const { tours } = Astro.props;
const site = await getSiteData();

const DIAS = ['lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado', 'domingo'] as const;
const capitalizar = (s: string) => s[0].toUpperCase() + s.slice(1);

const porDia = DIAS.map((dia) => ({
  dia,
  tours: tours.filter((t) => t.data.dia === dia).sort((a, b) => a.data.hora.localeCompare(b.data.hora)),
}));
const diasConTours = porDia.filter((d) => d.tours.length > 0);
const diasSinTours = porDia.filter((d) => d.tours.length === 0).map((d) => d.dia);

const duracion = tours[0]?.data.duracion;
const hrefOtraFecha = whatsappLink(site.contacto.whatsapp.numero, mensajeOtraFecha());
---

<div id="agenda" class="flex flex-col gap-4 rounded-xl border border-azul-tinta/10 bg-blanco/70 p-6">
  <div class="flex flex-col gap-1">
    <p class="text-lg font-bold text-azul-tinta">{ui.tours.proximasSalidas}</p>
    <p class="text-sm text-piedra">
      {tours.length} {ui.tours.porSemana}
      {duracion ? ` · ${duracion} ${ui.tours.cadaUna}` : ''}
    </p>
  </div>

  <div class="flex flex-col gap-2">
    {
      diasConTours.map(({ dia, tours: toursDelDia }) => (
        <div class="grid grid-cols-[80px_1fr] items-center gap-3 rounded-lg bg-arena/60 p-3 sm:grid-cols-[96px_1fr]">
          <p class="text-xs font-bold uppercase tracking-wide text-piedra">{dia}</p>
          <div class="flex flex-col gap-2">
            {toursDelDia.map((tour) => (
              <a
                href={whatsappLink(site.contacto.whatsapp.numero, mensajeTour(tour.data))}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-3 rounded-md border border-azul-tinta/10 bg-blanco p-3 hover:border-azul-tinta"
              >
                <span class="text-sm font-semibold">{tour.data.nombre}</span>
                <span class="text-xs text-piedra">{tour.data.hora} h</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  {
    diasSinTours.length > 0 && (
      <div class="flex flex-wrap items-center justify-between gap-3 pt-1 text-sm text-piedra">
        <span>{diasSinTours.map(capitalizar).join(', ')}: solo privados</span>
        <a href={hrefOtraFecha} target="_blank" rel="noopener noreferrer" class="font-semibold text-azul-tinta hover:underline">
          {ui.tours.pedirOtraFecha}
        </a>
      </div>
    )
  }
</div>
