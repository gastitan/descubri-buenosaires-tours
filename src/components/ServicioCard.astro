---
interface Props {
  nombre: string;
  descripcion: string;
}
const { nombre, descripcion } = Astro.props;
---

<article class="flex flex-col gap-2 bg-blanco p-5">
  <h3 class="font-display text-lg font-semibold text-azul-tinta">{nombre}</h3>
  <p class="text-azul-grafito">{descripcion}</p>
</article>
