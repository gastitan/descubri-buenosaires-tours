---
interface Props {
  pregunta: string;
  respuesta: string;
}
const { pregunta, respuesta } = Astro.props;
---

<details class="faq-item rounded-lg border border-piedra/15 p-4">
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-3 font-display font-semibold text-azul-tinta"
  >
    {pregunta}
    <span class="faq-item__icono shrink-0 text-azul-grafito" aria-hidden="true">+</span>
  </summary>
  <p class="mt-2 text-azul-grafito">{respuesta}</p>
</details>

<style>
  .faq-item[open] .faq-item__icono {
    transform: rotate(45deg);
  }
  .faq-item__icono {
    display: inline-block;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item__icono {
      transition: none;
    }
  }
</style>
