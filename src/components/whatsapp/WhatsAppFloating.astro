---
import { getSiteData } from '../../lib/content';
import { whatsappLink, mensajeGenerico } from '../../lib/whatsapp';
import { ui } from '../../i18n/es';

interface Props {
  mensaje?: string;
}
const site = await getSiteData();
const { mensaje = mensajeGenerico(site.marca.nombre) } = Astro.props;
const href = whatsappLink(site.contacto.whatsapp.numero, mensaje);
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex flex-col items-end gap-2 p-4"
  style="padding-bottom: max(1rem, env(safe-area-inset-bottom)); padding-right: max(1rem, env(safe-area-inset-right));"
>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={ui.whatsapp.abrirWhatsapp}
    class="pointer-events-auto flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-blanco shadow-lg transition-transform hover:scale-105 motion-reduce:transform-none"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="h-7 w-7 fill-current">
      <path
        d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8 1-.2.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5.1-.1.6-.7.7-.9.1-.2.1-.4 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.1.1 1.7 2.6 4.1 3.5 2 .8 2.4.6 2.8.6.4 0 1.3-.5 1.5-1 .2-.5.2-.9.1-1Z"
      />
    </svg>
  </a>
</div>
