---
import type { CollectionEntry } from 'astro:content';
import ContentImage from './media/ContentImage.astro';
import { ui, formatDiaHora } from '../i18n/es';

interface Props {
  tour: CollectionEntry<'tours'>;
}
const { tour } = Astro.props;
const { data } = tour;
---

<a
  href={`/tours/${tour.id}`}
  class="group flex flex-col overflow-hidden rounded-xl border border-piedra/15 bg-blanco transition-transform hover:-translate-y-0.5 motion-reduce:transform-none"
>
  <ContentImage
    src={data.imagen}
    carpeta="tours"
    alt={data.imagenAlt}
    width={640}
    height={480}
    class="aspect-[4/3] w-full object-cover"
  />
  <div class="flex flex-1 flex-col gap-2 p-4">
    <p class="font-display text-lg font-semibold text-azul-tinta">{data.nombre}</p>
    <p class="text-sm text-azul-grafito">{formatDiaHora(data.dia, data.hora)}</p>
    <p class="text-azul-grafito">{data.descripcionCorta}</p>
    <span class="mt-auto pt-2 text-sm font-semibold text-azul-tinta underline-offset-4 group-hover:underline">
      {ui.tours.verRecorrido}
    </span>
  </div>
</a>
