---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentImage from '../../components/media/ContentImage.astro';
import WhatsAppCta from '../../components/whatsapp/WhatsAppCta.astro';
import { getSiteData } from '../../lib/content';
import { mensajeSalidaEspecial } from '../../lib/whatsapp';
import { textoPrecio } from '../../lib/textos';
import { proximasFechas, proximaFecha, formatearFecha } from '../../lib/salidas';
import { buildEventoSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { resolveImage } from '../../lib/images';
import { ui, formatHora, formatDuracion, capitalizar } from '../../i18n/es';

export async function getStaticPaths() {
  const salidas = await getCollection('salidasEspeciales');
  return salidas.map((salida) => ({
    params: { slug: salida.id },
    props: { salida },
  }));
}

const { salida } = Astro.props;
const { data } = salida;

const site = await getSiteData();
const proxima = proximaFecha(data.fechas);
const otrasFechas = proximasFechas(data.fechas).slice(1);
// En minúscula: se reutiliza tal cual en el mensaje de WhatsApp ("del viernes, 19 de..."), texto corrido.
const fechaLegible = proxima ? formatearFecha(proxima.inicio, { weekday: 'long', day: 'numeric', month: 'long' }) : null;
const horaLegible = proxima ? formatHora(formatearFecha(proxima.inicio, { hour: '2-digit', minute: '2-digit' })) : null;
const mensaje = mensajeSalidaEspecial(data.nombre, fechaLegible);

const urlAbsoluta = new URL(`/salidas/${salida.id}`, Astro.site).toString();
const breadcrumbSchema = buildBreadcrumbSchema([
  { nombre: 'Inicio', url: new URL('/', Astro.site).toString() },
  { nombre: data.titulo, url: urlAbsoluta },
]);
const eventoSchema = buildEventoSchema(data, site, urlAbsoluta);
const jsonLdExtra = eventoSchema ? [eventoSchema, breadcrumbSchema] : breadcrumbSchema;

const assetOg = data.ogImagen ? resolveImage(data.ogImagen, 'salidas') : undefined;
const ogImage = assetOg ? (await getImage({ src: assetOg, width: 1200, height: 630 })).src : undefined;

const assetFlyer = data.flyer ? resolveImage(data.flyer, 'salidas') : undefined;
const flyerUrl = assetFlyer ? (await getImage({ src: assetFlyer })).src : undefined;

const labelWhatsapp = proxima ? ui.whatsapp.ctaTour : ui.whatsapp.ctaGenerico;
---

<BaseLayout
  title={data.titulo}
  description={data.descripcionCorta}
  image={ogImage}
  mensajeWhatsapp={mensaje}
  jsonLdExtra={jsonLdExtra}
>
  <div class="bg-azul-tinta text-blanco">
    <article class="mx-auto max-w-4xl px-4 py-10">
      <ContentImage
        src={data.imagen}
        carpeta="salidas"
        alt={data.imagenAlt}
        width={1200}
        height={800}
        loading="eager"
        class="aspect-[3/2] w-full rounded-xl object-cover"
      />

      <p class="mt-6 text-xs font-bold uppercase tracking-widest text-ocre">{ui.salidas.eyebrow}</p>
      <h1 class="mt-2 font-display text-3xl font-semibold md:text-4xl">{data.titulo}</h1>
      <p class="mt-3 max-w-xl text-arena/90">{data.descripcionCorta}</p>

      {
        proxima ? (
          <div class="mt-6 inline-flex flex-col gap-1 rounded-xl border border-ocre/30 bg-blanco/5 p-4">
            <p class="text-xs font-bold uppercase tracking-wide text-ocre">{ui.salidas.inicioDelTour}</p>
            <p class="text-lg font-semibold">
              {fechaLegible && capitalizar(fechaLegible)} · {horaLegible}
            </p>
          </div>
        ) : (
          <div class="mt-6 max-w-xl rounded-xl border border-dashed border-ocre/40 bg-blanco/5 p-4">
            <p class="text-arena/90">{ui.salidas.sinProximaFecha}</p>
          </div>
        )
      }

      <div class="mt-6">
        <WhatsAppCta mensaje={mensaje} label={labelWhatsapp} />
      </div>

      <section class="mt-10">
        <h2 class="font-display text-xl font-semibold">{ui.salidas.sobreElRecorrido}</h2>
        <div class="mt-3 flex flex-col gap-4 text-arena/90">
          {data.descripcionLarga.split('\n\n').map((parrafo) => <p>{parrafo}</p>)}
        </div>
        <h3 class="sr-only">{ui.salidas.destacados}</h3>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {data.destacados.map((item) => (
            <li class="rounded-lg bg-blanco/5 px-3 py-2 text-sm text-arena/90">{item}</li>
          ))}
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="font-display text-xl font-semibold">{ui.salidas.recorrido}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {data.barrios.map((barrio) => (
            <li class="rounded-full border border-ocre/40 px-4 py-1.5 text-sm text-arena">{barrio}</li>
          ))}
        </ul>
        {data.finalizaEn && (
          <p class="mt-4 text-sm text-arena/80">
            <span class="font-semibold text-ocre">{ui.salidas.finalizamosEn}</span> {data.finalizaEn}
          </p>
        )}
      </section>

      <dl class="mt-10 grid grid-cols-2 gap-4 rounded-xl bg-blanco/5 p-4 text-sm sm:grid-cols-4">
        <div>
          <dt class="font-semibold text-ocre">{ui.salidas.duracion}</dt>
          <dd class="text-arena/90">{formatDuracion(data.duracionMin, data.duracionMax)}</dd>
        </div>
        <div>
          <dt class="font-semibold text-ocre">{ui.salidas.modalidad}</dt>
          <dd class="text-arena/90">{ui.salidas.modalidadValores[data.modalidad]}</dd>
        </div>
        <div>
          <dt class="font-semibold text-ocre">{ui.salidas.puntoDeEncuentro}</dt>
          <dd class="text-arena/90">{data.puntosEncuentro ?? ui.salidas.puntoAConfirmar}</dd>
        </div>
        <div>
          <dt class="font-semibold text-ocre">{ui.salidas.precio}</dt>
          <dd class="text-arena/90">{textoPrecio(data.precio)}</dd>
        </div>
      </dl>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <section>
          <h2 class="font-display text-lg font-semibold text-ocre">{ui.salidas.incluye}</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {data.incluye.map((item) => (
              <li class="flex items-start gap-2 text-arena/90">
                <span aria-hidden="true" class="mt-0.5 text-ocre">
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="font-display text-lg font-semibold text-arena/80">{ui.salidas.noIncluye}</h2>
          <ul class="mt-3 flex flex-col gap-2">
            {data.noIncluye.map((item) => (
              <li class="flex items-start gap-2 border-b border-dashed border-arena/50 pb-2 text-arena/70 last:border-b-0">
                <span aria-hidden="true" class="mt-0.5">
                  ✕
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      {
        otrasFechas.length > 0 && (
          <section class="mt-10">
            <h2 class="font-display text-lg font-semibold text-ocre">{ui.salidas.proximasFechasTitulo}</h2>
            <ul class="mt-3 flex flex-col gap-2">
              {otrasFechas.map((f) => (
                <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg bg-blanco/5 px-4 py-2">
                  <span class="text-arena/90">
                    {capitalizar(formatearFecha(f.inicio, { weekday: 'long', day: 'numeric', month: 'long' }))}
                  </span>
                  <span class="text-sm text-arena/70">{formatHora(formatearFecha(f.inicio, { hour: '2-digit', minute: '2-digit' }))}</span>
                  {f.nota && <span class="w-full text-xs text-arena/60">{f.nota}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-12 flex flex-col items-start gap-4 border-t border-arena/20 pt-8">
        <p class="text-arena/90">
          {site.horarioAtencion.texto}. {ui.salidas.ctaFinalTexto}
        </p>
        <WhatsAppCta mensaje={mensaje} label={labelWhatsapp} />
      </div>

      {
        flyerUrl && (
          <p class="mt-6 text-sm">
            <a href={flyerUrl} download class="text-arena/70 underline-offset-4 hover:text-arena hover:underline">
              {ui.salidas.descargarFlyer}
            </a>
          </p>
        )
      }
    </article>
  </div>
</BaseLayout>
