---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicioCard from '../components/ServicioCard.astro';
import WhatsAppCta from '../components/whatsapp/WhatsAppCta.astro';
import { getSiteData, getServiciosData } from '../lib/content';
import { mensajeGenerico } from '../lib/whatsapp';
import { ui } from '../i18n/es';

const site = await getSiteData();
const servicios = await getServiciosData();
---

<BaseLayout
  title={ui.servicios.titulo}
  description="Recorridos privados, visitas educativas, actividades para empresas, city tours y experiencias personalizadas en Buenos Aires."
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-display text-3xl font-semibold text-azul-tinta md:text-4xl">{ui.servicios.titulo}</h1>
    <p class="mt-3 text-azul-grafito">
      Además de los siete recorridos de agenda fija, armo propuestas a medida según quién esté del otro lado.
    </p>

    <div class="mt-8 flex flex-col divide-y divide-piedra/15 rounded-xl border border-piedra/15">
      {servicios.map((servicio) => (
        <ServicioCard nombre={servicio.nombre} descripcion={servicio.descripcion} />
      ))}
    </div>

    <div class="mt-8">
      <WhatsAppCta mensaje={mensajeGenerico(site.marca.nombre)} label={ui.whatsapp.ctaGenerico} />
    </div>
  </section>
</BaseLayout>
