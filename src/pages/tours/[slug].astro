---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentImage from '../../components/media/ContentImage.astro';
import WhatsAppCta from '../../components/whatsapp/WhatsAppCta.astro';
import { getToursOrdenados } from '../../lib/content';
import { mensajeTour } from '../../lib/whatsapp';
import { textoPuntoEncuentro, textoPrecio } from '../../lib/textos';
import { buildTouristTripSchema, buildBreadcrumbSchema } from '../../lib/schema';
import { getSiteData } from '../../lib/content';
import { resolveImage } from '../../lib/images';
import { ui, formatDiaHora, formatDuracion } from '../../i18n/es';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({
    params: { slug: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { data } = tour;

const site = await getSiteData();
const otrosTours = (await getToursOrdenados()).filter((t) => t.id !== tour.id);
const mensaje = mensajeTour(data);
const urlAbsoluta = new URL(`/tours/${tour.id}`, Astro.site).toString();
const breadcrumbSchema = buildBreadcrumbSchema([
  { nombre: 'Inicio', url: new URL('/', Astro.site).toString() },
  { nombre: 'Recorridos', url: new URL('/#recorridos', Astro.site).toString() },
  { nombre: data.titulo, url: urlAbsoluta },
]);
const jsonLdExtra = [buildTouristTripSchema(data, site, urlAbsoluta), breadcrumbSchema];

const assetFoto = resolveImage(data.imagen, 'tours');
const ogImage = assetFoto ? (await getImage({ src: assetFoto, width: 1200, height: 630 })).src : undefined;
---

<BaseLayout
  title={data.titulo}
  description={data.descripcionCorta}
  image={ogImage}
  mensajeWhatsapp={mensaje}
  jsonLdExtra={jsonLdExtra}
>
  <article class="mx-auto max-w-4xl px-4 py-10">
    <ContentImage
      src={data.imagen}
      carpeta="tours"
      alt={data.imagenAlt}
      width={1200}
      height={800}
      loading="eager"
      class="aspect-[3/2] w-full rounded-xl object-cover"
    />

    <h1 class="mt-6 font-display text-3xl font-semibold text-azul-tinta md:text-4xl">
      {data.titulo}
    </h1>

    <dl class="mt-4 grid grid-cols-2 gap-4 rounded-xl bg-arena/40 p-4 text-sm sm:grid-cols-4">
      <div>
        <dt class="font-semibold text-azul-tinta">Día y hora</dt>
        <dd class="text-azul-grafito">{formatDiaHora(data.dia, data.hora)}</dd>
      </div>
      <div>
        <dt class="font-semibold text-azul-tinta">{ui.tours.duracion}</dt>
        <dd class="text-azul-grafito">{formatDuracion(data.duracionMin, data.duracionMax)}</dd>
      </div>
      <div>
        <dt class="font-semibold text-azul-tinta">{ui.tours.dificultad}</dt>
        <dd class="capitalize text-azul-grafito">{data.dificultad}</dd>
      </div>
      <div>
        <dt class="font-semibold text-azul-tinta">{ui.tours.precio}</dt>
        <dd class="text-azul-grafito">{textoPrecio(data.precio)}</dd>
      </div>
    </dl>

    <div class="mt-6">
      <WhatsAppCta mensaje={mensaje} label={ui.whatsapp.ctaTour} />
    </div>

    <div class="prose prose-p:text-azul-grafito mt-8 max-w-none">
      {data.descripcionLarga.split('\n\n').map((parrafo) => <p>{parrafo}</p>)}
    </div>

    <section class="mt-8">
      <h2 class="font-display text-xl font-semibold text-azul-tinta">{ui.tours.destacados}</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {data.destacados.map((item) => (
          <li class="rounded-lg bg-arena/40 px-3 py-2 text-azul-grafito">{item}</li>
        ))}
      </ul>
    </section>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      <section>
        <h2 class="font-display text-lg font-semibold text-azul-tinta">{ui.tours.incluye}</h2>
        <ul class="mt-2 list-inside list-disc text-azul-grafito">
          {data.incluye.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section>
        <h2 class="font-display text-lg font-semibold text-azul-tinta">{ui.tours.noIncluye}</h2>
        <ul class="mt-2 list-inside list-disc text-azul-grafito">
          {data.noIncluye.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <section class="mt-8">
      <h2 class="font-display text-lg font-semibold text-azul-tinta">{ui.tours.queLlevar}</h2>
      <ul class="mt-2 list-inside list-disc text-azul-grafito">
        {data.queLlevar.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="mt-8 rounded-xl bg-arena/40 p-4">
      <h2 class="font-display text-lg font-semibold text-azul-tinta">{ui.tours.puntoDeEncuentro}</h2>
      <p class="mt-2 text-azul-grafito">{textoPuntoEncuentro(data.puntoEncuentro)}</p>
    </section>

    <nav aria-label="Otros recorridos" class="mt-12 border-t border-piedra/20 pt-6">
      <h2 class="font-display text-lg font-semibold text-azul-tinta">{ui.tours.volverARecorridos}</h2>
      <ul class="mt-3 flex flex-wrap gap-3">
        {otrosTours.map((otro) => (
          <li>
            <a
              href={`/tours/${otro.id}`}
              class="rounded-full border border-piedra/30 px-4 py-2 text-sm text-azul-tinta hover:bg-arena/40"
            >
              {otro.data.nombre}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</BaseLayout>
