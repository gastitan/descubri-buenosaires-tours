---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentImage from '../components/media/ContentImage.astro';
import WhatsAppCta from '../components/whatsapp/WhatsAppCta.astro';
import AgendaSemanal from '../components/AgendaSemanal.astro';
import FileteFlourish from '../components/FileteFlourish.astro';
import TourCard from '../components/TourCard.astro';
import ServicioCard from '../components/ServicioCard.astro';
import FaqItem from '../components/FaqItem.astro';
import SalidaEspecialCard from '../components/SalidaEspecialCard.astro';
import {
  getSiteData,
  getSobreData,
  getServiciosData,
  getFaqData,
  getToursOrdenados,
  getSalidasVigentes,
} from '../lib/content';
import { whatsappLink, mensajeGenerico, mensajeAMedida } from '../lib/whatsapp';
import { ui } from '../i18n/es';

const site = await getSiteData();
const sobre = await getSobreData();
const servicios = await getServiciosData();
const preguntas = (await getFaqData()).slice(0, 4);
const tours = await getToursOrdenados();
const salidasVigentes = await getSalidasVigentes();

const hrefAMedida = whatsappLink(site.contacto.whatsapp.numero, mensajeAMedida());
---

<BaseLayout
  title={site.marca.nombre}
  description={`${site.marca.lema} — recorridos guiados a pie por Buenos Aires, con agenda semanal fija.`}
>
  <section class="relative overflow-hidden bg-arena">
    <ContentImage
      src="hero.png"
      alt="El Obelisco de Buenos Aires junto al cartel de pasto &quot;BA&quot;, sobre la avenida 9 de Julio"
      width={1200}
      height={800}
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover object-[center_38%]"
    />
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(100deg, rgba(244,233,206,.97) 0%, rgba(244,233,206,.93) 10%, rgba(244,233,206,.66) 60%, rgba(244,233,206,.5) 100%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-[1fr_1.05fr] md:items-center md:gap-16 md:py-20">
      <div class="flex flex-col gap-5">
        <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-widest text-azul-grafito">
          <span class="h-[3px] w-8 shrink-0 bg-ocre" aria-hidden="true"></span>
          {ui.hero.eyebrow}
        </div>
        <h1 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-azul-tinta sm:text-5xl md:text-6xl">
          {ui.hero.titulo}
        </h1>
        <p class="max-w-md text-lg leading-relaxed text-azul-grafito">{ui.hero.subtitulo}</p>
        <div class="mt-1 flex flex-wrap gap-3">
          <WhatsAppCta mensaje={mensajeGenerico(site.marca.nombre)} label={ui.whatsapp.ctaGenerico} />
          <a
            href="#recorridos"
            class="inline-flex items-center rounded-lg border border-azul-tinta/30 px-6 py-3 text-sm font-semibold text-azul-tinta hover:border-azul-tinta"
          >
            {ui.hero.verRecorridos}
          </a>
        </div>
        <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm text-piedra">
          {ui.hero.confianza.map((texto) => <span>{texto}</span>)}
        </div>
      </div>

      <div class="md:w-full md:max-w-[420px] md:justify-self-end">
        <AgendaSemanal tours={tours} />
      </div>
    </div>
  </section>

  <section id="recorridos" class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <div class="mb-7 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-2">
        <p class="text-xs font-bold uppercase tracking-widest text-piedra">{ui.tours.eyebrowHome}</p>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-azul-tinta md:text-4xl">
          {ui.tours.tituloHome}
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-piedra">{ui.tours.subtituloHome}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {tours.map((tour) => <TourCard tour={tour} />)}
      <div class="flex flex-col justify-center gap-2 rounded-xl border border-dashed border-azul-tinta/25 p-5">
        <p class="font-display text-lg font-semibold text-azul-tinta">{ui.tours.otroBarrioTitulo}</p>
        <p class="text-sm text-azul-grafito">{ui.tours.otroBarrioTexto}</p>
        <a href={hrefAMedida} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-azul-tinta hover:underline">
          {ui.tours.pedirAMedida}
        </a>
      </div>
    </div>
  </section>

  {
    salidasVigentes.length > 0 && (
      <section id="salidas-especiales" aria-labelledby="salidas-especiales-titulo" class="mx-auto max-w-6xl px-4 py-14 md:py-20">
        <h2 id="salidas-especiales-titulo" class="sr-only">
          {ui.salidas.tituloSeccionHome}
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {salidasVigentes.map((salida) => <SalidaEspecialCard salida={salida} />)}
        </div>
      </section>
    )
  }

  <div class="flex justify-center py-4" role="separator">
    <FileteFlourish />
  </div>

  <section id="sobre-mi" aria-labelledby="sobre-titulo" class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <div class="grid overflow-hidden rounded-2xl bg-arena md:grid-cols-[340px_1fr]">
      <ContentImage
        src={sobre.foto}
        carpeta="tours"
        alt={sobre.fotoAlt}
        width={340}
        height={420}
        class="h-64 w-full object-cover md:h-full"
      />
      <div class="flex flex-col gap-4 p-8 md:p-12">
        <p class="text-xs font-bold uppercase tracking-widest text-piedra">{ui.sobreMi.eyebrowHome}</p>
        <p class="max-w-xl font-display text-2xl italic leading-snug text-azul-tinta md:text-3xl">
          "{ui.sobreMi.citaHome}"
        </p>
        <p class="max-w-xl text-azul-grafito">{sobre.resumenHome}</p>
        <h2 id="sobre-titulo" class="sr-only">{ui.sobreMi.titulo}</h2>
        <a href="/sobre-mi" class="text-sm font-bold text-azul-tinta hover:underline">
          {ui.sobreMi.linkHome}
        </a>
      </div>
    </div>
  </section>

  <section id="servicios" aria-labelledby="servicios-titulo" class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <div class="mb-6 flex items-end justify-between gap-8">
      <h2 id="servicios-titulo" class="font-display text-2xl font-semibold tracking-tight text-azul-tinta md:text-3xl">
        {ui.servicios.titulo}
      </h2>
      <a href="/servicios" class="whitespace-nowrap text-sm font-bold text-azul-tinta hover:underline">
        Ver todos →
      </a>
    </div>
    <div class="flex flex-col divide-y divide-piedra/15 rounded-xl border border-piedra/15 lg:grid lg:grid-cols-5 lg:divide-y-0 lg:divide-x lg:rounded-none lg:border-0">
      {servicios.map((servicio) => <ServicioCard nombre={servicio.nombre} descripcion={servicio.descripcion} />)}
    </div>
  </section>

  <div class="flex justify-center py-4" role="separator">
    <FileteFlourish />
  </div>

  <section id="faq" class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
    <div class="flex flex-col gap-4">
      <h2 id="faq-titulo" class="font-display text-2xl font-semibold tracking-tight text-azul-tinta md:text-3xl">
        {ui.faq.titulo}
      </h2>
      <div class="flex flex-col gap-3">
        {preguntas.map((p) => <FaqItem pregunta={p.pregunta} respuesta={p.respuesta} />)}
      </div>
      <a href="/preguntas-frecuentes" class="text-sm font-bold text-azul-tinta hover:underline">
        {ui.faq.verTodas} →
      </a>
    </div>

    <div class="flex flex-col justify-center gap-4 rounded-2xl bg-azul-tinta p-10 text-blanco">
      <h3 class="font-display text-2xl font-semibold leading-tight md:text-3xl">{ui.faq.ctaTitulo}</h3>
      <p class="text-sm leading-relaxed text-blanco/80">
        {site.horarioAtencion.texto}. Respondemos en el día y coordinamos el punto de encuentro.
      </p>
      <WhatsAppCta mensaje={mensajeGenerico(site.marca.nombre)} label={ui.whatsapp.ctaGenerico} class="self-start" />
      <a
        href={site.redes.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-blanco/75 hover:text-blanco"
      >
        Instagram {site.redes.instagram.usuario}
      </a>
    </div>
  </section>

  <!--
    Testimonios: todavía no hay ninguno (brief, sección 11 — no inventar). Cuando lleguen reseñas
    reales, agregar una colección `testimonios` (mismo patrón que `tours`) y una sección acá,
    entre "Servicios" y "FAQ".
  -->
</BaseLayout>
